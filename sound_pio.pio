.program sound_pio
;
; shift out pokey audio
; pop 32 bit integer from TX FIFO, use them as high delay
; pop 32 bit from osr for low period delay
; sm expected to execute at 1.789MHz 
; parameters: 
;   high period saved in y
;   low period saved in osr

.pio_version 0
.side_set 1 opt

; experiment one 32 bits parameter: low 16 bit low period, high 16 bit high period

start:
    pull
    mov x, osr
    jmp !x start

.wrap_target
update:
    pull noblock    side 0  ; takes X in case fifo is empty
    mov x, osr              ; copy most recent pulles value back to X
    jmp!x update     

    out y, 16
loop0:
    jmp y-- loop0   side 0

    out y, 16 
loop1:
    jmp y--, loop1  side 1
.wrap


% c-sdk {
void sound_pio_program_init(PIO pio, uint sm, uint offset, uint pin) {

    pio_gpio_init(pio, pin);

    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);

    pio_sm_config c = sound_pio_program_get_default_config(offset);

    //sm_config_set_set_pins(&c, pin, 1);
    sm_config_set_sideset_pins(&c, pin);

    float div = (float)clock_get_hz(clk_sys) / (1'789'000UL);
    //float div = (float)clock_get_hz(clk_sys) / (3578000UL);

    sm_config_set_clkdiv(&c, div);
    
    pio_sm_init(pio, sm, offset, &c);
}
%}